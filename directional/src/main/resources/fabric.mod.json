  "license": "GPL-3.0-only",
  "environment": "*",
  "entrypoints": {
    "main": ["dev.paul.simpleradiodirectional.DirectionalAntenna"],
    "client": ["dev.paul.simpleradiodirectional.client.DirectionalClient"],
    "fabric-gametest": ["dev.paul.simpleradiodirectional.gametest.DirectionalGameTests", "dev.paul.simpleradiodirectional.gametest.WideArrayGameTests"]
  },
  "mixins": ["simpleradio_directional.mixins.json"],
  "depends": {
    "fabricloader": ">=0.19.0", "fabric-api": "*", "minecraft": "1.20.1", "java": ">=17",
    "simpleradio": "1.20.1-4.5.7.9"
  },
  "suggests": { "simpleradio_repeaters": ">=0.5.6" }
