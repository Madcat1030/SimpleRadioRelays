{
  "schemaVersion": 1,
  "id": "simpleradio_repeaters",
  "version": "${version}",
  "name": "Simple Radio Repeaters",
  "description": "Persistent radio relays and channel transponders for Simple Radio, with optional focus-based dimension bridges and Nether radio tweaks. Both custom features default on only while native cross-dimensional radio is disabled.",
  "authors": [
    "Paul",
    "OpenAI"
  ],
  "license": "GPL-3.0-only",
  "environment": "*",
  "entrypoints": {
    "main": [
      "dev.paul.simpleradiorepeaters.SimpleRadioRepeaters"
    ],
    "client": [
      "dev.paul.simpleradiorepeaters.client.RepeatersClient"
    ],
    "fabric-gametest": [
      "dev.paul.simpleradiorepeaters.gametest.RepeaterGameTests",
      "dev.paul.simpleradiorepeaters.gametest.RelayDiagnosticsGameTests",
      "dev.paul.simpleradiorepeaters.gametest.CatalystGameTests",
      "dev.paul.simpleradiorepeaters.gametest.ExpansionGameTests",
      "dev.paul.simpleradiorepeaters.gametest.ExpansionHardwareGameTests"
    ]
  },
  "mixins": [
    "simpleradio_repeaters.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.19.0",
    "fabric-api": "*",
    "minecraft": "1.20.1",
    "java": ">=17",
    "simpleradio": "1.20.1-4.5.7.9",
    "voicechat": ">=1.20.1-2.6.0"
  }
}
