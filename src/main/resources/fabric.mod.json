{
  "schemaVersion": 1,
  "id": "simpleradio_repeaters",
  "version": "${version}",
  "name": "Simple Radio Repeaters",
  "description": "In-world six-card banks and catalyst-powered relays with persistent antenna networks for Simple Radio.",
  "authors": ["Paul", "OpenAI"],
  "license": "GPL-3.0-only",
  "environment": "*",
  "entrypoints": {
    "main": ["dev.paul.simpleradiorepeaters.SimpleRadioRepeaters"],
    "client": ["dev.paul.simpleradiorepeaters.client.RepeatersClient"],
    "fabric-gametest": ["dev.paul.simpleradiorepeaters.gametest.RepeaterGameTests", "dev.paul.simpleradiorepeaters.gametest.RelayDiagnosticsGameTests", "dev.paul.simpleradiorepeaters.gametest.CatalystGameTests"]
  },
  "mixins": ["simpleradio_repeaters.mixins.json"],
  "depends": {
    "fabricloader": ">=0.19.0",
    "fabric-api": "*",
    "minecraft": "1.20.1",
    "java": ">=17",
    "simpleradio": "1.20.1-4.5.7.9",
    "voicechat": ">=1.20.1-2.6.0"
  }
}
